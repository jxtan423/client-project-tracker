{
  "name": "client-project-tracker-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "migrate": "node scripts/migrate.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "prestart:dev": "node scripts/ensure-dev-env.cjs",
    "start:dev": "tsc-watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsc-watch": "^7.0.0",
    "typescript": "~5.9.0"
  }
}
